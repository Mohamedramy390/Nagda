generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
  EMPLOYEE
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  phone    String
  avatarUrl String?
  role     UserRole    @default(EMPLOYEE)
  position String  @default("")
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])

  officeId String
  office   Office  @relation(fields: [officeId], references: [id])

  
  // 1. Tickets this user created (links to "RequesterRelation")
  openedTickets   Ticket[] @relation("RequesterRelation")
  
  // 2. Tickets assigned to this user (links to "AgentRelation")
  assignedTickets Ticket[] @relation("AgentRelation")

  messages Message[]
}

model Office{
  id String @id @default(uuid())
  name String
  timeZone String
  users User[]
}

model Ticket {
  id        String         @id @default(uuid())
  ticketNum Int            @unique @default(autoincrement()) 
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  category  String @default("General")
  description String @default("No description provided")
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id]) 

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  resolvedAt DateTime?
  closedAt DateTime?
  messages  Message[]
  
  // Relation to the user who created it
  requesterId    String
  requester      User           @relation("RequesterRelation", fields: [requesterId], references: [id])

  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id])
  responseDueAt    DateTime   // The absolute "First Reply" deadline
  resolutionDueAt  DateTime   // The absolute "Fix It" deadline

  agentId    String?
  agent      User?           @relation("AgentRelation", fields: [agentId], references: [id])
}

model Department {
  id String @id @default(uuid())
  name String
  users User[]
  tickets Ticket[]
}

model Message {
  id          String   @id @default(uuid())
  content     String   
  createdAt   DateTime @default(now())
  
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model SlaPolicy {
  id              String       @id @default(uuid())
  name            String       
  priority        TicketPriority 
  responseTimeMin Int          
  resolutionTimeMin Int        

  tickets           Ticket[]
  is24x7          Boolean      @default(false) 
}